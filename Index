<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Badezimmer Lüftungs-Timer</title>
  <!-- Tailwind CSS via CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Google Font: Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <style>
    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      -webkit-tap-highlight-color: transparent;
    }

    /* Sanfte Kreis-Animation */
    .progress-ring__circle {
      transition: stroke-dashoffset 0.35s ease;
      transform: rotate(-90deg);
      transform-origin: 50% 50%;
    }

    /* Alarm-Pulsieren */
    @keyframes pulse-alarm {
      0%, 100% { transform: scale(1); opacity: 1; }
      50% { transform: scale(1.05); opacity: 0.9; }
    }
    .animate-alarm {
      animation: pulse-alarm 1.2s infinite ease-in-out;
    }
  </style>
</head>

<body class="bg-slate-900 text-slate-100 min-h-screen flex flex-col justify-between items-center p-4 selection:bg-cyan-500 selection:text-white">

  <!-- Kopfbereich: Badge & Titel -->
  <header class="w-full max-w-sm pt-4 text-center">
    <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-cyan-950/70 border border-cyan-500/30 text-cyan-400 text-xs font-semibold uppercase tracking-wider mb-2">
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
      </svg>
      Stoßlüftungs-Assistent
    </div>
    <h1 class="text-2xl font-bold tracking-tight text-white">Fenster-Timer</h1>
    <p class="text-slate-400 text-xs mt-1">Effektiv lüften – Feuchtigkeit & Schimmel stoppen</p>
  </header>

  <!-- Hauptbereich: Timer & Steuerung -->
  <main class="w-full max-w-sm flex flex-col items-center my-auto py-4">

    <!-- Dauer-Auswahl (Presets) -->
    <div class="grid grid-cols-3 gap-2 w-full mb-6">
      <button type="button" onclick="setPreset(180)" id="btn-180"
        class="preset-btn py-2.5 px-2 rounded-xl text-sm font-semibold transition border border-slate-700 bg-slate-800/80 text-slate-300 hover:border-cyan-500 active:scale-95">
        3 Min.
        <span class="block text-[10px] text-slate-400 font-normal">Winter</span>
      </button>

      <button type="button" onclick="setPreset(300)" id="btn-300"
        class="preset-btn py-2.5 px-2 rounded-xl text-sm font-semibold transition border border-cyan-500 bg-cyan-500/10 text-cyan-300 ring-2 ring-cyan-500/30 active:scale-95">
        5 Min.
        <span class="block text-[10px] text-cyan-300/80 font-normal">Optimal</span>
      </button>

      <button type="button" onclick="setPreset(480)" id="btn-480"
        class="preset-btn py-2.5 px-2 rounded-xl text-sm font-semibold transition border border-slate-700 bg-slate-800/80 text-slate-300 hover:border-cyan-500 active:scale-95">
        8 Min.
        <span class="block text-[10px] text-slate-400 font-normal">Sommer</span>
      </button>
    </div>

    <!-- Kreis-Visualisierung -->
    <div class="relative w-64 h-64 flex items-center justify-center">
      <svg class="w-full h-full" viewBox="0 0 200 200">
        <!-- Hintergrund-Kreis -->
        <circle cx="100" cy="100" r="86" stroke="currentColor" stroke-width="8" class="text-slate-800" fill="transparent" />
        <!-- Fortschritts-Kreis -->
        <circle id="progress-circle" class="progress-ring__circle text-cyan-400" cx="100" cy="100" r="86"
          stroke="currentColor" stroke-width="8" stroke-linecap="round" fill="transparent"
          stroke-dasharray="540.35" stroke-dashoffset="0" />
      </svg>

      <!-- Text im Zentrum des Kreises -->
      <div class="absolute inset-0 flex flex-col items-center justify-center text-center p-4">
        <span id="time-display" class="text-5xl font-extrabold tracking-tight tabular-nums text-white">05:00</span>
        <span id="status-label" class="text-xs uppercase tracking-wider font-semibold text-slate-400 mt-2 flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-slate-500"></span> Bereit
        </span>
      </div>
    </div>

    <!-- Alarm-Box bei Zeitablauf -->
    <div id="alarm-box" class="hidden mt-4 w-full bg-amber-500/10 border border-amber-500/30 p-4 rounded-2xl text-center animate-alarm">
      <div class="flex items-center justify-center gap-2 text-amber-400 font-bold text-lg">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
        </svg>
        Zeit abgelaufen!
      </div>
      <p class="text-sm text-slate-200 mt-1 font-medium">Bitte das Fenster jetzt wieder vollständig schließen.</p>
    </div>

    <!-- Primäre Action Buttons -->
    <div class="flex flex-col gap-3 w-full mt-6">
      <button type="button" id="main-btn" onclick="toggleTimer()"
        class="w-full py-4 px-6 rounded-2xl bg-cyan-500 hover:bg-cyan-400 active:scale-[0.98] text-slate-950 font-bold text-lg shadow-lg shadow-cyan-500/25 transition flex items-center justify-center gap-2">
        <svg id="main-btn-icon" class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
          <path d="M8 5v14l11-7z" />
        </svg>
        <span id="main-btn-text">Lüftung starten</span>
      </button>

      <button type="button" id="reset-btn" onclick="resetTimer()"
        class="w-full py-2.5 px-4 rounded-xl bg-slate-800 hover:bg-slate-700/80 active:scale-[0.98] text-slate-400 hover:text-white text-sm font-semibold transition border border-slate-700">
        Zurücksetzen
      </button>
    </div>

    <!-- Wake-Lock Status Indikator -->
    <div id="wakelock-status" class="mt-4 flex items-center justify-center gap-1.5 text-[11px] text-slate-500">
      <span class="w-1.5 h-1.5 rounded-full bg-slate-600"></span> Display-Sperre aktiv schützbar
    </div>

  </main>

  <!-- Fußzeile mit Sachhinweis -->
  <footer class="w-full max-w-sm pb-3 text-center text-slate-500 text-xs border-t border-slate-800 pt-3">
    <p class="leading-relaxed">
      <strong>Warum Stoßlüften?</strong> 5 Min. schnelles Querlüften tauscht die feuchte Luft komplett aus, ohne dass Wände und Fliesen auskühlen.
    </p>
  </footer>

  <script>
    // --- Initialisierung & Variablen ---
    const CIRCLE_RADIUS = 86;
    const CIRCUMFERENCE = 2 * Math.PI * CIRCLE_RADIUS;

    let totalDuration = 300; // 5 Minuten Standard
    let remainingSeconds = 300;
    let timerInterval = null;
    let isRunning = false;
    let wakeLock = null;
    let audioCtx = null;

    // DOM-Referenzen
    const progressCircle = document.getElementById('progress-circle');
    const timeDisplay = document.getElementById('time-display');
    const statusLabel = document.getElementById('status-label');
    const mainBtn = document.getElementById('main-btn');
    const mainBtnText = document.getElementById('main-btn-text');
    const mainBtnIcon = document.getElementById('main-btn-icon');
    const alarmBox = document.getElementById('alarm-box');
    const wakelockStatus = document.getElementById('wakelock-status');

    progressCircle.style.strokeDasharray = `${CIRCUMFERENCE}`;
    progressCircle.style.strokeDashoffset = '0';

    // --- Web Audio API: Klang-Synthese (kein externes Audio-File nötig) ---
    function initAudioContext() {
      if (!audioCtx) {
        const AudioContextClass = window.AudioContext || window.webkitAudioContext;
        if (AudioContextClass) {
          audioCtx = new AudioContextClass();
        }
      }
      if (audioCtx && audioCtx.state === 'suspended') {
        audioCtx.resume();
      }
    }

    // Melodischer Dreiklang zur Erinnerung
    function playAlarmSound() {
      try {
        initAudioContext();
        if (!audioCtx) return;

        const tones = [587.33, 739.99, 880.00, 1174.66]; // D5, F#5, A5, D6
        tones.forEach((freq, index) => {
          const osc = audioCtx.createOscillator();
          const gain = audioCtx.createGain();

          osc.type = 'sine';
          osc.frequency.setValueAtTime(freq, audioCtx.currentTime + (index * 0.18));

          gain.gain.setValueAtTime(0, audioCtx.currentTime + (index * 0.18));
          gain.gain.linearRampToValueAtTime(0.3, audioCtx.currentTime + (index * 0.18) + 0.04);
          gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + (index * 0.18) + 0.6);

          osc.connect(gain);
          gain.connect(audioCtx.destination);

          osc.start(audioCtx.currentTime + (index * 0.18));
          osc.stop(audioCtx.currentTime + (index * 0.18) + 0.65);
        });
      } catch (err) {
        console.warn('Audio-Wiedergabe nicht möglich:', err);
      }
    }

    // --- Screen Wake Lock API (Bildschirm bleibt an) ---
    async function requestWakeLock() {
      if ('wakeLock' in navigator) {
        try {
          wakeLock = await navigator.wakeLock.request('screen');
          wakelockStatus.innerHTML = '<span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span> Display bleibt aktiv';
          wakelockStatus.classList.remove('text-slate-500');
          wakelockStatus.classList.add('text-emerald-400');
        } catch (err) {
          console.warn('Wake Lock Fehler:', err);
        }
      }
    }

    function releaseWakeLock() {
      if (wakeLock !== null) {
        wakeLock.release().then(() => {
          wakeLock = null;
          wakelockStatus.innerHTML = '<span class="w-1.5 h-1.5 rounded-full bg-slate-600"></span> Display-Sperre freigegeben';
          wakelockStatus.classList.remove('text-emerald-400');
          wakelockStatus.classList.add('text-slate-500');
        });
      }
    }

    // --- Formatierung & Anzeige ---
    function formatTime(seconds) {
      const mins = Math.floor(seconds / 60);
      const secs = seconds % 60;
      return `${mins.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;
    }

    function updateDisplay() {
      timeDisplay.textContent = formatTime(remainingSeconds);
      const progress = (totalDuration - remainingSeconds) / totalDuration;
      const offset = CIRCUMFERENCE * progress;
      progressCircle.style.strokeDashoffset = offset;
    }

    // --- Preset-Auswahl ---
    function setPreset(seconds) {
      if (isRunning) {
        clearInterval(timerInterval);
        isRunning = false;
        releaseWakeLock();
      }

      totalDuration = seconds;
      remainingSeconds = seconds;
      alarmBox.classList.add('hidden');

      // Button-Styles aktualisieren
      [180, 300, 480].forEach(val => {
        const btn = document.getElementById(`btn-${val}`);
        if (val === seconds) {
          btn.className = 'preset-btn py-2.5 px-2 rounded-xl text-sm font-semibold transition border border-cyan-500 bg-cyan-500/10 text-cyan-300 ring-2 ring-cyan-500/30 active:scale-95';
        } else {
          btn.className = 'preset-btn py-2.5 px-2 rounded-xl text-sm font-semibold transition border border-slate-700 bg-slate-800/80 text-slate-300 hover:border-cyan-500 active:scale-95';
        }
      });

      statusLabel.innerHTML = '<span class="w-2 h-2 rounded-full bg-slate-500"></span> Bereit';
      mainBtnText.textContent = 'Lüftung starten';
      mainBtn.classList.remove('bg-amber-500', 'hover:bg-amber-400');
      mainBtn.classList.add('bg-cyan-500', 'hover:bg-cyan-400');
      mainBtnIcon.innerHTML = '<path d="M8 5v14l11-7z" />';

      updateDisplay();
    }

    // --- Timer Logik ---
    function toggleTimer() {
      // Audio-Context beim ersten Klick scharfschalten
      initAudioContext();

      if (isRunning) {
        // Pausieren
        clearInterval(timerInterval);
        isRunning = false;
        releaseWakeLock();
        statusLabel.innerHTML = '<span class="w-2 h-2 rounded-full bg-amber-400"></span> Pausiert';
        mainBtnText.textContent = 'Fortsetzen';
        mainBtnIcon.innerHTML = '<path d="M8 5v14l11-7z" />';
      } else {
        // Starten
        if (remainingSeconds <= 0) {
          remainingSeconds = totalDuration;
          alarmBox.classList.add('hidden');
        }

        isRunning = true;
        requestWakeLock();

        statusLabel.innerHTML = '<span class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse"></span> Lüftung läuft...';
        mainBtnText.textContent = 'Pausieren';
        mainBtnIcon.innerHTML = '<path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/>';

        timerInterval = setInterval(() => {
          remainingSeconds--;
          updateDisplay();

          if (remainingSeconds <= 0) {
            clearInterval(timerInterval);
            timerComplete();
          }
        }, 1000);
      }
    }

    function timerComplete() {
      isRunning = false;
      releaseWakeLock();
      statusLabel.innerHTML = '<span class="w-2 h-2 rounded-full bg-amber-400"></span> Fertig!';
      mainBtnText.textContent = 'Erneut lüften';
      mainBtnIcon.innerHTML = '<path d="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"/>';

      // Visueller Alarm
      alarmBox.classList.remove('hidden');

      // Akustisches Signal (wiederholt sich 2-mal kurz)
      playAlarmSound();
      setTimeout(playAlarmSound, 1200);

      // Handy-Vibration auslösen (sofern vom Browser unterstützt)
      if ('vibrate' in navigator) {
        navigator.vibrate([400, 200, 400, 200, 600]);
      }
    }

    function resetTimer() {
      if (isRunning) {
        clearInterval(timerInterval);
        isRunning = false;
      }
      releaseWakeLock();
      remainingSeconds = totalDuration;
      alarmBox.classList.add('hidden');
      statusLabel.innerHTML = '<span class="w-2 h-2 rounded-full bg-slate-500"></span> Bereit';
      mainBtnText.textContent = 'Lüftung starten';
      mainBtnIcon.innerHTML = '<path d="M8 5v14l11-7z" />';
      updateDisplay();
    }

    // Initialanzeige vorbereiten
    updateDisplay();
  </script>
</body>
</html>
